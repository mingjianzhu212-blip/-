        mastery: { alchemyLv: 1, alchemyExp: 0, forgeLv: 1, forgeExp: 0 },   /* 匠道修为：丹师/器师阶位与经验 */
        recipeN: {},                                        /* 丹方旁支：每张正方已炼炉数（第 69 节，{dan1: 4}） */
        tower: 1,                                           /* 镇妖塔当前层（从 1 开始） */
        towerMax: 0,                                        /* 镇妖塔历史最高通关层 */
