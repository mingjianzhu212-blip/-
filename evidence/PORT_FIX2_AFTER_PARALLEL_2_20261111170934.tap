        "  const S = { name: '', sex: 'm', gender: 'male', robe: 'bai', rank: 0, exp: 0, stone: 0, cave: 0, dan: 0, forge: 0, dao: 0, rootIdx: 1, last: Date.now(), log: [], field: 0, bag: [], powScale: POW_K,\n" +
    +   '    /* 太虚真人引导 V1（2026-11-11）：引导进度/跳过/补讲/奖励凭证，随主存档同一事务提交 */\n' +
    +   '    guide: { step: 0, done: false, skipped: false, flags: {}, rewardClaims: {}, toldSystems: {} },\n' +
        '    gong1: 0, gong2: 0, gong3: 0,                       /* 三种功法等级（逐步进阶） */\n' +
        '    herb: 0, ore: 0,                                    /* 材料：灵草 / 矿石（炼丹、炼器用） */\n' +
        '    mine: 0,                                            /* 矿脉等级（产矿石） */\n' +
        '    plots: [],                                          /* 灵田田块：[{crop,t0,need}]，空位 = null（种田闭环） */\n' +
        '    weapon: 0,                                          /* 当前法宝品质：0无 1下品 2中品 3上品 4极品 */\n' +
    ...
        '    guardMirror: 0,                                      /* 护心镜：突破失败时返还 50% 已扣修为（被动） */\n' +
